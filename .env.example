# Copiar este archivo como .env y cambiar los valores locales necesarios.
# No colocar credenciales reales en .env.example.

DJANGO_SECRET_KEY=change-this-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Fase 1: SQLite
DATABASE_URL=sqlite:///db.sqlite3

# Fase 2: MySQL
# Se habilitará únicamente después de aprobar completamente SQLite.
# Ejemplo de formato, sin credenciales reales:
# DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/loteria_taller3