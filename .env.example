# Copiar como .env y cambiar únicamente valores locales.
# Nunca versionar la clave real ni contraseñas locales.
DJANGO_SECRET_KEY=change-this-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Fase 1 del Taller #3: SQLite.
DATABASE_URL=sqlite:///db.sqlite3

# Seed demo opcional. Déjalo vacío salvo que ejecutes seed_demo en local.
DJANGO_DEMO_PASSWORD=

# Fase 2: MySQL, solo después de aprobar SQLite.
# DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/loteria_taller3

# Producción HTTPS; los valores seguros se activan por defecto con DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
